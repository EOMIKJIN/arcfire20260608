{
  "expo": {
    "name": "아크파이어",
    "slug": "arcfire-online",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "arcfire",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.arcfire.online",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "CFBundleDisplayName": "Arcfire Online"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/arcfire_logo_01.png",
        "backgroundColor": "#F5F0E8"
      },
      "package": "com.arcfire.online",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-navigation-bar",
      "@react-native-firebase/app"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}