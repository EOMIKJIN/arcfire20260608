{
  "name": "arcfire-online",
  "version": "0.1.1",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild:clean": "npx expo prebuild --clean --platform android",
    "clean:android": "cd android && ./gradlew clean && cd .. && npx expo prebuild",
    "fix:content-csv-encoding": "node tools/content-tables/ensure-csv-utf8-bom.mjs",
    "build:content-tables": "node tools/gen-mineral-region-members.mjs && node tools/balance-tables/rebalance-weapon-ttk.mjs && node tools/content-tables/gen-weapon-trade-listing-policy.mjs && node tools/content-tables/sync-weapon-trade-listing.mjs && node tools/content-tables/patch-item-defs-en.mjs && node tools/content-tables/patch-missions-en.mjs && node tools/content-tables/patch-npc-ships-en.mjs && node tools/content-tables/patch-planets-en.mjs && node tools/content-tables/build-content-from-csv.mjs",
    "build:planet-nebula-bakes": "tsx tools/planet-nebula-bake/bake-planet-nebula-images.ts",
    "gen:trade-route-assignments": "node tools/gen-trade-route-planet-assignments.mjs",
    "build:balance-tables": "node tools/gen-trade-route-planet-assignments.mjs && node tools/balance-tables/patch-synth-colonization-en.mjs && node tools/balance-tables/build-balance-from-csv.mjs",
    "audit:balance": "node tools/balance-audit/run-balance-audit.cjs",
    "audit:balance-ops": "node tools/balance-ops-audit/run-balance-ops-audit.cjs",
    "audit:planet-economy-3h": "node tools/planet-economy-3h-audit/run-planet-economy-3h-audit.cjs",
    "audit:team-lead:daily": "node tools/kim-team-lead/run-daily-economy-review.cjs",
    "audit:aabs-verify": "node tools/aabs-verify/run-aabs-verify.cjs",
    "agds:patch-overlay": "node tools/agds/patch-dynamic-overlay.cjs",
    "build:world-expansion-graph": "npx tsx tools/world-expansion/export-master-graph.ts",
    "verify:arc-expansion": "npx tsx tools/world-expansion/verify-arc-core-daily-unlock.ts",
    "verify:trade-port-listing": "npx tsx tools/verify-trade-port-buy-listing.ts",
    "audit:daily": "node tools/daily-perf-audit/run-daily-audit.cjs",
    "daily:commit": "node tools/daily-commit/run-daily-commit.cjs",
    "audit:memory": "node tools/memory-audit/run-memory-audit.cjs",
    "audit:skia-memory": "node tools/memory-audit/run-skia-worklet-memory-audit.cjs",
    "audit:memory:all": "npm run audit:memory && npm run audit:skia-memory",
    "audit:session:economy-tick": "node tools/session-stability-watch/run-economy-balance-tick.cjs",
    "audit:session:5h-final": "node tools/session-stability-watch/run-final-5h-audit.cjs",
    "audit:session:watch": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/session-stability-watch/start-session-watch.ps1",
    "test:planet-pgp": "npx tsx src/world/planetPgpModel.test.ts",
    "audit:ui-overlay": "node tools/ui-overlay-audit/run-ui-overlay-audit.cjs",
    "audit:i18n": "node tools/i18n-audit/run-i18n-audit.cjs",
    "audit:arc-self-optimize:pack": "node tools/arc-core-self-optimize/prepare-handoff.cjs",
    "sim:ship-upgrade-value": "npx tsx tools/ship-upgrade-value/run-ship-upgrade-value.ts",
    "sim:economy": "npm run verify:economy-sim-cohort && npx tsx tools/economy-sim/run-economy-sim.ts",
    "verify:economy-sim-cohort": "npx tsx tools/verify-economy-sim-cohort.ts",
    "export:galaxy-map:image": "tsx tools/galaxy-map/export-galaxy-map-image.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-firebase/analytics": "^24.0.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/auth": "^24.0.0",
    "@react-native-firebase/firestore": "^24.0.0",
    "@shopify/react-native-skia": "1.2.3",
    "ansi-styles": "^4.3.0",
    "d3-delaunay": "^6.0.4",
    "expo": "~51.0.0",
    "expo-application": "~5.9.1",
    "expo-constants": "~16.0.2",
    "expo-font": "~12.0.0",
    "expo-haptics": "~13.0.0",
    "expo-linking": "~6.3.1",
    "expo-navigation-bar": "~3.0.7",
    "expo-router": "~3.5.0",
    "expo-splash-screen": "~0.27.0",
    "expo-status-bar": "~1.12.0",
    "expo-system-ui": "~3.0.7",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.0",
    "react-native-reanimated": "~3.10.0",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/d3-delaunay": "^6.0.4",
    "@types/react": "~18.2.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "patch-package": "^8.0.0",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "~5.3.3"
  }
}
