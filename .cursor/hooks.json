{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/on-session-start-paid-model-gate.cjs",
        "timeout": 5
      },
      {
        "command": ".cursor/hooks/on-session-start-agent-routing.cjs"
      },
      {
        "command": ".cursor/hooks/on-session-start-pss-pre-dev-brief.cjs",
        "timeout": 5
      },
      {
        "command": ".cursor/hooks/on-session-start-kim-claude-handoff-review.cjs",
        "timeout": 5
      },
      {
        "command": ".cursor/hooks/on-session-start-mem-post-dev-trigger.cjs",
        "timeout": 8
      },
      {
        "command": ".cursor/hooks/on-session-start-monitor-autostart.cjs",
        "timeout": 20
      },
      {
        "command": ".cursor/hooks/on-session-start-daily-report-chat.cjs",
        "timeout": 10
      },
      {
        "command": ".cursor/hooks/on-session-start-incident-triage.cjs",
        "timeout": 15
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/on-before-submit-prompt-paid-model-gate.cjs",
        "timeout": 5
      },
      {
        "command": ".cursor/hooks/on-before-submit-prompt-agent-routing.cjs",
        "timeout": 5
      },
      {
        "command": ".cursor/hooks/on-before-submit-prompt-pss-pre-dev-gate.cjs",
        "timeout": 5
      },
      {
        "command": ".cursor/hooks/on-before-submit-prompt-kim-claude-handoff-review.cjs",
        "timeout": 5
      },
      {
        "command": ".cursor/hooks/on-before-submit-prompt-daily-report-chat.cjs",
        "timeout": 8
      },
      {
        "command": ".cursor/hooks/on-before-submit-prompt-incident-auto-fix.cjs",
        "timeout": 8
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/on-stop-kim-claude-handoff-auto-review.cjs",
        "timeout": 5,
        "loop_limit": 2
      }
    ]
  }
}
